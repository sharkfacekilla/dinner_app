// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is handled by prisma.config.ts
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  String?
  category    String?
  tags        String[]

  // Every recipe belongs to the user who created it
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  ingredients  Ingredient[]
  instructions Instruction[]
  favorites    Favorite[]
  shares       RecipeShare[]
  photo        RecipeImage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Accounts are only created from the command line (npm run user), never from the website
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  recipes      Recipe[]
  sessions     Session[]
  favorites    Favorite[]
  sharedWithMe RecipeShare[]
}

// The cookie holds a random token; only its SHA-256 hash is stored here
model Session {
  id        String   @id // sha256(token), hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Favorites are per person
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
}

// The owner shares a recipe with a specific person
model RecipeShare {
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([recipeId, userId])
  @@index([userId])
}

model Ingredient {
  id       String  @id @default(cuid())
  name     String
  amount   String?
  unit     String?
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Instruction {
  id       String  @id @default(cuid())
  step     Int
  text     String
  tip      String?
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

// Uploaded recipe photo, already resized/re-encoded to JPEG with metadata stripped (lib/images.ts).
// Stored in the database so one pg_dump backs up everything.
model RecipeImage {
  recipeId  String   @id
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  data      Bytes
  width     Int
  height    Int
  updatedAt DateTime @updatedAt
}
